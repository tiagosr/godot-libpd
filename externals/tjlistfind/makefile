# tjlistfind — classic Pd external (vanilla Pd 0.4x–0.6x and Plugdata).
#
# Build (classic external layout; place this directory under pd/extra/ or
# point PD at your pd source tree):
#
#   make PD=/path/to/pd-source
#
# The result (tjlistfind<arch>, e.g. tjlistfind_macosx) goes where Pd looks
# for externals (~/pd/externals on macOS, the extra dir on Linux, or copy it
# into Plugdata's externals folder).

NAME = tjlistfind
OBJ  = $(NAME).o
PD   = ../../../

include $(PD)/src/rules
